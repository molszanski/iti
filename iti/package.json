{
  "name": "iti",
  "version": "0.8.0-alpha.1",
  "description": "~1kB Dependency Injection Library for Typescript and React with a unique async flow support",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "typings": "./dist/index.d.mts",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "source": "src/index.ts",
  "publishConfig": {
    "source": "./src/index.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "make build",
    "stryker": "ATTEST_skipTypes=1 stryker",
    "stryker:run": "ATTEST_skipTypes=1 stryker run",
    "test:ci": "vitest run",
    "test:watch": "ATTEST_skipTypes=1 vitest -- --skipTypes  --benchPercentThreshold 10",
    "test:types": "vitest run",
    "v": "vitest",
    "lol": "vitest run ./tests/type-tests/basic-test.vi.spec.ts",
    "vitest:types": "vitest --typecheck"
  },
  "dependencies": {
    "utility-types": "^3.10.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/jest-runner": "^8.6.0",
    "@stryker-mutator/typescript-checker": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.0.15",
    "dedent": "^1.6.0",
    "microbundle": "^0.15.1",
    "stryker-cli": "^1.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=12"
  },
  "license": "MIT",
  "authors": [
    "Nick Olszanski <nick@dinosaurs-with-jetpacks.com>"
  ],
  "repository": "molszanski/iti",
  "keywords": [
    "ioc",
    "di",
    "inversion of control",
    "dependency injection",
    "dependency inversion",
    "inversion of control container",
    "container",
    "javascript",
    "typescript",
    "type-safe"
  ],
  "homepage": "https://itijs.org",
  "// CONFIGS: ": "Package configs",
  "prettier": {
    "semi": false,
    "singleQuote": false,
    "arrowParens": "always",
    "trailingComma": "all"
  }
}
