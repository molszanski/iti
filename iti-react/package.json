{
  "name": "iti-react",
  "version": "0.8.0",
  "description": "Handy React bindings for iti, a ~1kB Typesafe dependency injection framework for TypeScript and JavaScript with a unique support for async flow",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/iti-react.js",
  "typings": "./dist/index.d.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/iti-react.js"
      },
      "default": "./dist/iti-react.js"
    },
    "./package.json": "./package.json"
  },
  "source": "src/index.ts",
  "publishConfig": {
    "source": "./src/index.ts",
    "module": "./dist/iti-react.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && microbundle -o dist/  --jsx React.createElement --format modern",
    "dev": "microbundle watch -o dist/ --jsx React.createElement",
    "test": "IS_REACT_ACT_ENVIRONMENT=true vitest run",
    "t": "IS_REACT_ACT_ENVIRONMENT=true vitest run ./tests/react-hooks-errors.test.ts"
  },
  "dependencies": {
    "iti": "0.8.0",
    "utility-types": "^3.10.0"
  },
  "devDependencies": {
    "microbundle": "^0.15.1"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "repository": "https://github.com/molszanski/iti",
  "homepage": "https://itijs.org",
  "author": "Nick Olszanski",
  "license": "MIT",
  "prettier": {
    "semi": false,
    "singleQuote": false,
    "arrowParens": "always",
    "trailingComma": "all"
  }
}
